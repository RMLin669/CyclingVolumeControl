<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:gravity="top|center_horizontal"
    android:background="?android:attr/colorBackground">

    <!-- 1. 隐私安全提示 - 修改为按钮触发弹窗 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="0dp">

        <Button
            android:id="@+id/btnShowPrivacy"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="点击查看隐私说明与使用建议 ▾"
            android:textSize="12sp"
            android:textColor="?android:attr/textColorSecondary" />

        <!-- 注意：这里删除了之前的 privacyDetailsText，因为我们要用弹窗显示 -->
    </LinearLayout>


    <!-- 2. 权限行：修改按钮样式为有背景的样式 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="0dp"
        android:paddingHorizontal="70dp">

        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="GPS 精确位置权限"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="?android:attr/textColorPrimary" />

        <Button
            android:id="@+id/btnPermissionFine"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="授权"
            android:minWidth="10dp" />
    </LinearLayout>

    <!-- 3. 速度和音量显示 -->
    <TextView
        android:id="@+id/speedText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="当前速度: 0.0 km/h"
        android:textSize="30sp"
        android:textColor="?android:attr/colorPrimary"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/volumeText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="0dp"
        android:text="当前音量: 0%"
        android:textSize="25sp"
        android:textColor="?android:attr/colorPrimary"/>

    <!-- 修改设备显示文本的 ID 含义 -->
    <TextView
        android:id="@+id/deviceTypeText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="当前配置: 检测中..."
        android:textSize="14sp"
        android:paddingHorizontal="12dp"
        android:paddingVertical="4dp"
        android:background="@drawable/bg_picker_selection"
        android:textColor="?android:attr/colorPrimary"
        android:textStyle="bold" />

    <!-- 在 deviceTypeText 下方插入 -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="26dp"
        android:layout_marginTop="5dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="打开应用检测到该设备后自动开启控制"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="13sp" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/autoStartSwitch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:scaleX="0.8"
            android:scaleY="0.8" />
    </LinearLayout>

    <!-- 通知栏常驻保活开关 -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="38dp"
        android:layout_marginTop="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="通知栏常驻以实现保活"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="13sp" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/persistNotifSwitch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:scaleX="0.8"
            android:scaleY="0.8" />
    </LinearLayout>

    <!-- 4. 采样平滑设置 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="0dp"
        android:paddingHorizontal="60dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="速度采样平滑 (秒):"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="14sp" />

        <Spinner
            android:id="@+id/samplingSpinner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="3dp"
            android:entries="@array/sampling_options" />
    </LinearLayout>

    <!-- 速度和音量自定义设置区 -->
    <com.google.android.material.card.MaterialCardView
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginHorizontal="4dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="0dp"
        app:strokeWidth="1dp"
        app:strokeColor="?attr/colorOutlineVariant">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="14dp"
            android:paddingBottom="18dp">

            <!-- 标题行 + 最大速度输入 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp">

                <!-- 左侧：标题 + 副标题 -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="速度 → 音量曲线"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="?android:attr/textColorPrimary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="拖动控制点调整映射关系"
                        android:textSize="11sp"
                        android:layout_marginTop="1dp"
                        android:textColor="?android:attr/textColorSecondary" />
                </LinearLayout>

                <!-- 右侧：最大速度 pill 输入框 -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="118dp"
                    android:layout_height="wrap_content"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense"
                    android:hint="最大速度"
                    app:suffixText="km/h"
                    app:boxCornerRadiusTopStart="24dp"
                    app:boxCornerRadiusTopEnd="24dp"
                    app:boxCornerRadiusBottomStart="24dp"
                    app:boxCornerRadiusBottomEnd="24dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/editMaxSpeedX"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:text="40"
                        android:textSize="14sp"
                        android:gravity="center"
                        android:imeOptions="actionDone"
                        android:singleLine="true" />

                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <!-- 交互式速度-音量坐标图 -->
            <com.example.cyclingvolumecontrol.SpeedVolumeChartView
                android:id="@+id/speedVolumeChart"
                android:layout_width="match_parent"
                android:layout_height="230dp" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- 5. 控制按钮 -->
    <Button
        android:id="@+id/btnStart"
        android:layout_width="200dp"
        android:layout_height="50dp"
        android:layout_marginTop="10dp"
        android:backgroundTint="?android:attr/colorPrimary"
        android:enabled="false"
        android:text="开始控制音量"
        android:textSize="20sp"
        style="@style/Widget.MaterialComponents.Button"
        android:textColor="?attr/colorOnPrimary"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        app:cornerRadius="25dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?android:attr/selectableItemBackground"
        android:padding="16dp"
        android:text="当前速度与音量开始控制后才会实时更新。\n控制过程中无法调节速度区间与音量区间，如需调节请先暂停控制。"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="12sp"
        android:lineSpacingExtra="4dp"
        android:layout_marginBottom="0dp" />

</LinearLayout>